# ========================================================
# HẠ TẦNG CƠ SỞ DỮ LIỆU PHÂN MẢNH (HORIZONTAL SHARDING)
# Node 1: clinic_hanoi (clinic_id = 1)
# Node 2: clinic_hcm   (clinic_id = 2)
# ========================================================

# Cấu hình kết nối MySQL dùng chung
DB_HOST=localhost
DB_PORT=3306
DB_USER=root

# Mật khẩu tài khoản root:
# - Với XAMPP / phpMyAdmin: Để trống (DB_PASSWORD=)
# - Với MySQL Workbench: Điền mật khẩu root cá nhân (VD: DB_PASSWORD=root hoặc 123456)
DB_PASSWORD=

# Tham số tối ưu Connection Pooling chuẩn Production
DB_POOL_LIMIT=10
DB_QUEUE_LIMIT=0

# Cổng khởi chạy máy chủ Express
PORT=3000
