erDiagram
    CLINIC {
        int clinic_id PK
        string name
        string location
        string db_node_ip
    }

    DOCTOR {
        int doctor_id PK
        int clinic_id FK
        string full_name
        string specialty
    }

    PATIENT {
        int patient_id PK
        int origin_clinic_id FK "Sharding Key: Node CSDL gốc"
        string identity_card "Số CCCD/CMND"
        string full_name
        string phone_number
        string gender "Nam, Nu, Khac"
        date date_of_birth
        string address
        string blood_type
        string medical_history "Tien su benh an"
        datetime created_at
        datetime updated_at
    }

    APPOINTMENT {
        int appointment_id PK
        int patient_id FK
        int doctor_id FK
        int clinic_id FK
        datetime slot_time
        string status "Pending, Confirmed, Cancelled"
    }

    CLINIC ||--o{ DOCTOR : "has"
    CLINIC ||--o{ PATIENT : "manages (sharding)"
    CLINIC ||--o{ APPOINTMENT : "hosts"
    DOCTOR ||--o{ APPOINTMENT : "assigned_to"
    PATIENT ||--o{ APPOINTMENT : "books"